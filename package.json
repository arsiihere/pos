{
  "name": "pos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "test": "pnpm --filter @pos/client build && vitest run",
    "test:e2e": "pnpm --filter @pos/client build && pnpm --filter @pos/client exec playwright test",
    "test:perf": "bash tools/test-perf.sh",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck typecheck:tests"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "jiti": "2.7.0",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  }
}
